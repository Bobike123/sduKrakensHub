# Copy to .env.local (git ignores it) and fill in. Never commit real values.
# The same names go into the Vercel project settings (Production and Preview).

# Public: safe to ship to the browser. Row Level Security is what protects data.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only: never prefix with PUBLIC_, never paste into chat or commit.
# Used solely for admin actions (create member, reset password, deactivate).
SUPABASE_SECRET_KEY=sb_secret_...

# Local development uses `npx supabase start`, which prints its own URL and keys:
#   PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
